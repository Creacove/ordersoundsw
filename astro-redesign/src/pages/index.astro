---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTwo from '../components/SectionTwo.astro';
import SectionThree from '../components/SectionThree.astro';
import '../styles/journey.css';
const deskUrl = import.meta.env.PUBLIC_DESK_URL || 'https://desk.ordersounds.com/';
---
<BaseLayout>
  <div class="hero-journey">
    <div class="object-rail" aria-label="Desk's record and work">
      <div class="object-stage"></div>
    </div>
    <section class="chapter chapter--hero" aria-label="Make the music">
      <div class="world world--music" aria-hidden="true"></div>
      <Hero />
    </section>
    <section class="chapter chapter--work" aria-label="Everything around the music">
      <div class="world world--work" aria-hidden="true"></div>
      <SectionTwo />
    </section>
    <section class="chapter chapter--signals" aria-label="All your signals">
      <div class="world world--focus" aria-hidden="true"></div>
      <SectionThree />
    </section>
  </div>
  <section class="next-act" aria-labelledby="next-act-title">
    <div class="next-act__orbit" aria-hidden="true"></div>
    <div class="next-act__content">
      <span>THE NEXT ACT</span>
      <h2 id="next-act-title">Make what’s next.</h2>
      <p>Desk handles the work around the music.</p>
      <a href={deskUrl}>Enter Desk <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <script is:inline>
    const stage = document.querySelector('.object-stage');
    for (const selector of ['.hero__stage','.turn-control','.section-two__stage','.s3-stage']) {
      const object = document.querySelector(selector);
      if (object) stage.append(object);
    }
    const journey = document.querySelector('.hero-journey');
    const sections = ['hero','work','signals'];
    const setAct = () => {
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let active = 'hero';
      for (const name of sections) {
        if (journey.querySelector('.chapter--' + name).getBoundingClientRect().top <= innerHeight * .5) active = name;
      }
      journey.dataset.act = active;
    };
    // Copy stays in document flow; only its passage through the mobile art
    // zone is masked. Reversing scroll naturally reveals it again.
    const copies = [...document.querySelectorAll('.section-two__copy,.section-three__copy')];
    const protectCopy = () => {
      if (innerWidth > 600) return;
      const edges = copies.map(copy => innerHeight * (copy.classList.contains('section-two__copy') ? .46 : .39) - copy.getBoundingClientRect().top);
      copies.forEach((copy,i) => copy.style.setProperty('--reading-edge', Math.max(0,edges[i]) + 'px'));
    };
    let frame = 0;
    const scheduleProtection = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; protectCopy(); });
    };
    protectCopy();
    addEventListener('scroll',scheduleProtection,{passive:true});
    addEventListener('resize',scheduleProtection);
    setAct();
    addEventListener('scroll',setAct,{passive:true});
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change',setAct);
  </script>
</BaseLayout>
