---
import HeroScene from './HeroScene.jsx';
const deskUrl = import.meta.env.PUBLIC_DESK_URL || '/login';
---
<section class="hero" data-hero>
  <div class="studio" aria-hidden="true"><div class="studio__light"></div><div class="studio__floor"></div><div class="studio__leaves"></div></div>

  <header class="hero__nav">
    <a class="brand" href="/" aria-label="OrderSounds home">
      <img class="brand__wordmark" src="/hero/ordersounds-logo.png" alt="" /><strong>OrderSounds</strong>
      <span class="brand__divider"></span>
      <span class="brand__desk">Desk</span>
    </a>
    <a class="top-cta" href={deskUrl}>Enter Desk <span aria-hidden="true">→</span></a>
  </header>

  <div class="hero__copy" data-hero-copy>
    <h1><span class="copy-mask"><span data-copy-line>Make the</span></span><span class="copy-mask"><span data-copy-line>music.</span></span></h1>
    <h2 class="hero__bridge" data-bridge>Desk handles<br />the other side.</h2>
    <p class="hero__support" data-back-support aria-hidden="true" inert>The work that keeps your<br class="desktop-only" /> career moving.</p>
    <a class="primary-cta" href={deskUrl}>Enter Desk <span aria-hidden="true">→</span></a>
  </div>

  <div class="hero__stage">
    <div class="object-shadow" aria-hidden="true"></div>
    <HeroScene client:only="react" />
  </div>
  <button type="button" class="turn-control" data-turn aria-label="Turn the record sleeve">Turn sleeve <span aria-hidden="true">↻</span></button>
</section>
