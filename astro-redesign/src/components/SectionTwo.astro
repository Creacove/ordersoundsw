---
const props = [
  ['releases','releases-booklet',1448,1086],
  ['marketing','marketing-sheet',1122,1402],
  ['business','business-sheet',1448,1086],
  ['opportunities','opportunities-pass',1086,1448],
  ['next','whats-next-note',1448,1086],
  ['record','record-sleeve-vinyl',1000,750],
  ['handled','handled-stack',1448,1086],
];
---
<section class="section-two" aria-labelledby="section-two-title">
  <div class="section-two__copy">
    <span class="section-two__eyebrow">DESK</span>
    <h2 id="section-two-title"><span class="copy-mask"><span class="s2-line">All the work</span></span><span class="copy-mask"><span class="s2-line">around the</span></span><span class="copy-mask"><span class="s2-line">music. Handled.</span></span></h2>
    <p class="sr-only">Desk helps manage releases, marketing, business, opportunities and what comes next.</p>
  </div>
  <div class="section-two__stage" aria-hidden="true">
    <div class="s2-bundle-contact" aria-hidden="true"></div>
    {props.map(([id,file,width,height]) => <div class={`s2-prop s2-${id}`} data-s2={id}>
      <img src={`/section2/${file}.webp`} width={width} height={height} alt="" decoding="async" loading="eager" />
    </div>)}
  </div>
</section>
<script>
  import '../scripts/section-two';
</script>
<style is:global>
 .hero-journey .hero{overflow:visible;isolation:auto}
 .hero-journey .hero__nav{z-index:60}
 .section-two{position:absolute;inset:0;pointer-events:none;visibility:hidden;overflow:visible}
 .section-two__copy{position:absolute;left:7.7%;top:28%;z-index:12;width:38%}
 .section-two__eyebrow{display:block;color:#a044e3;font-size:17px;font-weight:550;margin-bottom:18px}
 .section-two h2{margin:0;font-size:clamp(46px,4.35vw,76px);font-weight:570;letter-spacing:-.058em;line-height:.95}
 .section-two__stage{position:absolute;inset:0}
 .s2-prop{position:absolute;transform-origin:50% 85%;filter:drop-shadow(2px 8px 6px #382b201c)}
 .s2-prop>img{display:block;width:100%;height:auto}
 .s2-record{left:44%;top:32%;width:39%;z-index:5;filter:drop-shadow(1px 9px 6px #382b2029)}
 .s2-releases{left:32%;top:19%;width:29%;z-index:2}
 .s2-marketing{left:56%;top:8%;width:25%;z-index:1}
 .s2-business{left:76%;top:26%;width:31%;z-index:3}
 .s2-opportunities{left:27%;top:55%;width:19%;z-index:7;filter:drop-shadow(2px 10px 7px #382b2029)}
 .s2-next{left:76%;top:61%;width:28%;z-index:8}
 .s2-handled{left:58%;top:48%;width:40%;z-index:9;opacity:0;filter:drop-shadow(3px 12px 8px #382b2029)}
 .hero-journey .sleeve-brand,.hero-journey .sleeve-face--front .sound-mark{opacity:var(--s2-brand-opacity,1)}
 .s2-bundle-contact{position:absolute;left:52%;top:83%;width:39%;height:8%;background:radial-gradient(ellipse,#49332538 0%,#4933251a 35%,transparent 72%);opacity:0;z-index:1;transform:scaleX(.7);pointer-events:none}
 .s2-releases{filter:drop-shadow(3px 6px 5px #3d2d201c)}
 .s2-marketing{filter:drop-shadow(5px 8px 7px #3d2d201c)}
 .s2-business{filter:drop-shadow(5px 7px 5px #3d2d2024)}
 .s2-opportunities{filter:drop-shadow(2px 4px 2px #3d2d2029) drop-shadow(7px 11px 8px #3d2d2017)}
 .s2-next{filter:drop-shadow(2px 5px 3px #3d2d2024) drop-shadow(6px 10px 8px #3d2d2017)}
 .s2-handled{filter:drop-shadow(2px 4px 2px #3d2d202e) drop-shadow(7px 12px 8px #3d2d2024)}
 @media(max-width:1000px){.s2-bundle-contact{left:17%;top:64%;width:72%;height:8%}}
 @media(max-width:600px){.s2-bundle-contact{left:17%;top:63%;width:66%;height:7%}}
 @media(prefers-reduced-motion:reduce){.s2-bundle-contact{opacity:.6}}
 .s2-line{display:block}.hero-journey .hero__stage{transform-origin:0 0}.hero-journey .hero__copy{z-index:12}
 .section-two .copy-mask{padding-block:.13em;margin-block:-.13em}
 .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
 @media(max-width:1000px){
  .hero-journey .hero{height:100svh;min-height:0;max-height:none}
  .section-two__copy{top:14%;left:7%;width:85%}
  .section-two h2{font-size:clamp(48px,7vw,70px)}
  .section-two__stage{top:33%;height:65%}
  .s2-record{left:28%;top:30%;width:56%}
  .s2-releases{left:9%;top:10%;width:34%}
  .s2-marketing{left:47%;top:0;width:35%}
  .s2-business{left:76%;top:23%;width:31%}
  .s2-opportunities{left:4%;top:48%;width:34%}
  .s2-next{left:75%;top:58%;width:28%}
  .s2-handled{left:54%;top:40%;width:43%}
 }
 @media(max-width:600px){
  .section-two__copy{top:14%;left:7%;width:90%}
  .section-two__eyebrow{font-size:13px;margin-bottom:12px}
  .section-two h2{font-size:clamp(38px,10.7vw,57px)}
  .section-two__stage{top:38%;height:59%}
  .s2-record{left:18%;top:30%;width:76%}
  .s2-releases{left:-5%;top:9%;width:49%}
  .s2-marketing{left:44%;top:0;width:48%}
  .s2-business{left:75%;top:17%;width:48%}
  .s2-opportunities{left:-13%;top:51%;width:48%}
  .s2-next{left:74%;top:57%;width:39%}
  .s2-handled{left:47%;top:42%;width:52%}
 }
 @media(prefers-reduced-motion:reduce){
  .section-two{position:relative;height:100svh;min-height:650px;visibility:visible}
  .s2-releases,.s2-marketing,.s2-business,.s2-opportunities,.s2-next{display:none}
  .s2-handled{opacity:1;left:52%;top:20%;width:43%}.s2-record{display:none}
  @media(max-width:1000px){.s2-handled{left:16%;top:20%;width:70%}}
 }
</style>
